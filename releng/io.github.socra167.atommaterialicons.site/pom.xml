<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.socra167.atommaterialicons</groupId>
    <artifactId>atommaterialicons-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>io.github.socra167.atommaterialicons.site</artifactId>
  <packaging>eclipse-repository</packaging>

  <profiles>
    <!--
      Signs the plug-in and feature with PGP so Eclipse can show who published them.
      Activate with -Psign and provide the armored secret key in the
      file named by -Dtycho.pgp.signer.bc.secretKeys=<path> and its passphrase in the
      MAVEN_GPG_PASSPHRASE environment variable.
    -->
    <profile>
      <id>sign</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>tycho-gpg-plugin</artifactId>
            <version>${tycho.version}</version>
            <executions>
              <execution>
                <id>pgpsigner</id>
                <goals>
                  <goal>sign-p2-artifacts</goal>
                </goals>
                <configuration>
                  <signer>bc</signer>
                  <addPublicKeyToRepo>true</addPublicKeyToRepo>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
